{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doodle Dash",
  "version": "1.0.0",
  "identifier": "studio.datatree.doodledash",
  "build": {
    "frontendDist": "../build/exe",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --mode exe --port 5173 --strictPort",
    "beforeBuildCommand": "npx vite build --mode exe"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DataTree Studios",
    "copyright": "Designed by BooleanChitra · Developed by DataTree Studios",
    "category": "Game",
    "shortDescription": "A doodle-styled 3D platformer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
